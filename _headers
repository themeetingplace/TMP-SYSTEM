# Netlify _headers — 套全站 HTTP 安全標頭 (P2-4)
# 部署後可用 securityheaders.com / Mozilla Observatory 驗證
#
# 路徑語法：/* 代表所有 URL；可細分如 /api/* 個別覆蓋

/*
  # ── 反 clickjacking ──
  X-Frame-Options: DENY
  # ── 阻止 MIME sniffing ──
  X-Content-Type-Options: nosniff
  # ── referrer 隱藏 ──
  Referrer-Policy: strict-origin-when-cross-origin
  # ── HTTPS 強制 (1 年；includeSubDomains 之後再開) ──
  Strict-Transport-Security: max-age=31536000
  # ── 權限 ──
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # ── CSP：暫時移除做 LIFF 診斷；確認 LIFF 通了再加回來精修 ──
  # 原 CSP: default-src 'self'; script-src ... (見 git log)

# LIFF 子目錄 — 因為要被 LINE 嵌 iframe，X-Frame-Options 改 SAMEORIGIN
/liff/*
  X-Frame-Options: SAMEORIGIN
