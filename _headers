# Netlify _headers — 套全站 HTTP 安全標頭 (P2-4)
# 部署後可用 securityheaders.com / Mozilla Observatory 驗證
#
# 路徑語法：/* 代表所有 URL；可細分如 /api/* 個別覆蓋

/*
  # ── 反 clickjacking — 改 SAMEORIGIN 避免跟 /liff/* 設定衝突合併成無效值 ──
  X-Frame-Options: SAMEORIGIN
  # ── 阻止 MIME sniffing ──
  X-Content-Type-Options: nosniff
  # ── referrer 隱藏 ──
  Referrer-Policy: strict-origin-when-cross-origin
  # ── HTTPS 強制 (1 年；includeSubDomains 之後再開) ──
  Strict-Transport-Security: max-age=31536000
  # ── 權限 ──
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # ── CSP：自己 + 第三方 CDN + Supabase + LINE wildcard ──
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://unpkg.com https://fonts.googleapis.com https://*.line-scdn.net https://*.line.me; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://unpkg.com; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https://*.line-scdn.net https://*.line.me https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.line.me https://*.line-scdn.net; frame-src 'self' https://*.line.me; object-src 'none'; base-uri 'self';

# LIFF 子目錄 — 因為要被 LINE 嵌 iframe，X-Frame-Options 改 SAMEORIGIN
/liff/*
  X-Frame-Options: SAMEORIGIN
